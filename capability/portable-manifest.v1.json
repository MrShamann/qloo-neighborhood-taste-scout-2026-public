    "automatic_import_enabled": false,
    "private_system_dependency": false,
    "requirements": [
      "Exact rights holder authorization",
      "Independent receiving-system interface review",
      "Qloo provider data and API clearance",
      "Provenance/security audit",
      "Separate integration tests"
    ],
    "source_code_or_credentials_transfer": "NONE"
  }
