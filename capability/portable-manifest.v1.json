    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bridge_id",
        "mode"
      ],
      "properties": {
        "bridge_id": {
          "type": "string",
          "enum": [
            "bridge-new-york",
            "bridge-tokyo",
            "bridge-paris"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        }
      }
    },
    "output_contract": {
      "type": "object",
      "required": [
        "mode",
        "provider_verified",
        "provider_api_calls",
        "scene_id",
        "city",
        "artists",
        "places",
        "agent_steps",
        "automatic_actions",
        "human_confirmation_required"
      ],
      "result_categories": [
        "SOURCE_VALUES_FOR_BOTH_REVIEW_ONLY",
        "SECOND_INTEREST_NOT_EVIDENCED",
        "ABSTAIN_NO_INTEREST_ATTRIBUTION"
      ],
      "provenance_labels": [
        "QLOO_HACKATHON_TWO_ARTIST_API_LIVE",
        "SYNTHETIC_BRIDGE_REPLAY_NO_API"
      ],
      "guarantee": "Live place names originate from Qloo's authenticated response and are for human review only, not preference or suitability claims."
    },
    "failures": [
      {
        "http_status": 400,
        "kind": "BAD_JSON_OR_QUERY"
      },
      {
        "http_status": 403,
        "kind": "ORIGIN_OR_RIGHTS_GATES"
      },
      {
        "http_status": 409,
        "kind": "CONCURRENT_LIVE_REQUEST"
      },
      {
        "http_status": 413,
        "kind": "REQUEST_TOO_LARGE"
      },
      {
        "http_status": 415,
        "kind": "INVALID_CONTENT_TYPE"
      },
      {
        "http_status": 422,
        "kind": "INVALID_BRIEF_OR_NO_LIVE_ACCESS"
      },
      {
        "http_status": 429,
        "kind": "SPONSOR_BUDGET_EXHAUSTED"
      },
      {
        "http_status": 502,
        "kind": "SOURCE_FAILED_NO_RETRY"
      },
      {
        "http_status": 503,
        "kind": "PERSISTENT_GUARD_OR_ASSET_UNAVAILABLE"
      }
    ]
  },
  "provider": {
    "mandated_by_contest": "Qloo Taste AI",
    "api_origin": "https://hackathon.api.qloo.com",
    "allowed_read_paths": [
      "/search",
      "/v2/insights"
    ],
    "maximum_reads_per_live_run": 3,
    "retries": 0,
