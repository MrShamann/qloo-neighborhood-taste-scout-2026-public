    "output_cache_policy": "DO_NOT_CACHE_QLOO_RESULTS_FOR_JUDGES",
    "secret_delivery": "SERVER_SIDE_ONLY",
    "infrastructure": "Independent zero-new-spend Free candidate; no private platform dependency"
  },
  "safety": {
    "actual_side_effects": [
      "Authorized Qloo read-only GET requests",
      "Durable Object budget reservations and short lease"
    ],
    "forbidden_side_effects": [
      "Payment",
      "Booking",
      "Outreach",
      "Personal profile collection",
      "Private venture access"
