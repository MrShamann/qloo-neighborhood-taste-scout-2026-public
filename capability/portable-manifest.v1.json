  "provenance": {
    "public_repository": "https://github.com/MrShamann/qloo-neighborhood-taste-scout-2026-public",
    "source_paths": [
      "src/taste_bridge.py",
      "src/taste_scout.py",
      "src/source_snapshot.py",
      "cloudflare/worker.mjs",
      "web/app.js"
